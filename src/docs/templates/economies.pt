<tal:page_with_sidebar_template metal:use-macro="load: main_template.pt">

<div metal:fill-slot='body'>
    <div class="row">
        <div class="col-xs-12">
            <div class="page-header text-center">
                <h2>${doc_helper.t('DOC_ECO_TITLE')}</h2>
                <p>${doc_helper.t('DOC_ECO_INTRO')}</p>
                <ul class="list-inline">
                    <tal:economies repeat="economy firs.economy_manager">
                        <li><a href="#${doc_helper.get_economy_name_char_safe(economy)}">${doc_helper.get_economy_name(economy)}</a></li>
                    </tal:economies>
                </ul>
            </div>
        </div>
    </div>
    <tal:economies repeat="economy firs.economy_manager">
        <div class="row" id="${doc_helper.get_economy_name_char_safe(economy)}"  style="padding-bottom:20px;">
            <div class="col-xs-12 col-sm-4">
                <h3 class="firs-title-with-anchor">
                    <a href="#${doc_helper.get_economy_name_char_safe(economy)}">${doc_helper.get_economy_name(economy)}</a>
                </h3>
                <p class="lead">${structure:doc_helper.get_economy_extra_info(economy)}</p>
            </div>
            <div class="col-xs-12 col-sm-8" style="padding-top:16px;">

                <h4>${doc_helper.t('DOC_ECO_CARGOS', count=len(economy.cargos))}</h4>
                <tal:cargos repeat="cargo sorted(economy.cargos, key=doc_helper.get_cargo_name)">
                    <a href="${doc_helper.link('cargos')}#${cargo.id}">
                        ${doc_helper.get_cargo_name(cargo)}${(',', '')[repeat.cargo.end]}
                    </a>
                </tal:cargos>

                <h4>${doc_helper.t('DOC_ECO_INDUSTRIES', count=len(economy.industries))}</h4>
                <tal:industries repeat="industry sorted(economy.industries, key=doc_helper.get_industry_name)">
                    <a href="${doc_helper.link('industries')}#${industry.id}">${doc_helper.get_industry_name(industry, economy)}${(',', '')[repeat.industry.end]}</a>
                </tal:industries>
            </div>
            <div class="col-xs-12">
                <div style="margin-top: 40px; margin-bottom: 40px;">
                    <h4>${doc_helper.t('DOC_ECO_CARGO_FLOW')}</h4>
                    <object style="max-width:100%;" data="${doc_helper.get_economy_name_char_safe(economy)}.dot.svg" type="image/svg+xml"></object>
                </div>

                <div class="pull-right">
                    <a href="cargoflow_${doc_helper.get_economy_name_char_safe(economy)}.html">
                        <i class="fa fa-search-plus"></i> ${doc_helper.t('DOC_ECO_VIEW_LARGER')}
                    </a>
                    |
                    <a href="${doc_helper.get_economy_name_char_safe(economy)}.dot"><small>${doc_helper.t('DOC_ECO_DOWNLOAD_DOT')}</small></a>
                </div>
            </div>
        </div>
        <hr />
    </tal:economies>
</div>
</tal:page_with_sidebar_template>

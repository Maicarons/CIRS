<tal:page_with_sidebar_template metal:use-macro="load: main_template.pt">
<div metal:fill-slot='body'>
    <div class="page-header">
        <h1>${doc_helper.t('DOC_TRANS_TITLE')}</h1>
        <p>${doc_helper.t('DOC_TRANS_INTRO')}</p>
    </div>

    <h2>${doc_helper.t('DOC_TRANS_CURRENT')}</h2>
    <ul class="list-inline">
        <tal:languages repeat="language doc_helper.get_language_links()">
            <li><a href="${language[1]}"><i class="fa fa-globe"></i> ${language[0]}</a></li>
        </tal:languages>
    </ul>
    <br />
    <hr />

    <h2>${doc_helper.t('DOC_TRANS_HOW')}</h2>
    <p>${doc_helper.t('DOC_TRANS_HOW_P1')}</p>
    <p>${doc_helper.t('DOC_TRANS_HOW_P2')}</p>
    <p>${doc_helper.t('DOC_TRANS_HOW_P3')}</p>
    <br />
    <hr />

    <h2>${doc_helper.t('DOC_TRANS_HISTORY')}</h2>
    <p>${doc_helper.t('DOC_TRANS_HISTORY_P1')}</p>
    <p>${doc_helper.t('DOC_TRANS_THANKS')}</p>
</div>
</tal:page_with_sidebar_template>

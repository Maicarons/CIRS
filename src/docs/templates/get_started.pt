<tal:main_template metal:use-macro="load: main_template.pt">
<div metal:fill-slot='body'>
    <div class="row">
        <div class="col-xs-12">
            <div class="page-header text-center">
                <ul class="list-inline">
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_CARGOS', count=len(firs.cargo_manager))}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_INDUSTRIES', count=len(firs.industry_manager))}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_ECONOMIES', count=len(firs.economy_manager))}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_PRIMARY')}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_SECONDARY')}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_SNOW')}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_PIXELS')}</li>
                    <li><i class="fa fa-check-circle-o"></i> ${doc_helper.t('DOC_GS_FEATURE_LICENSE')}</li>
                </ul>
                <ul class="list-inline">
                    <li><a href="#firs-gameplay">${doc_helper.t('DOC_GS_ANCHOR_GAMEPLAY')}</a></li>
                    <li><a href="#download-firs">${doc_helper.t('DOC_GS_ANCHOR_DOWNLOAD')}</a></li>
                    <li><a href="#choose-economy">${doc_helper.t('DOC_GS_ANCHOR_SETUP')}</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row" id="firs-gameplay">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_GAMEPLAY_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p class="lead" style="margin-top:1em;">${doc_helper.t('DOC_GS_GAMEPLAY_LEAD')}</p>
            <ul>
                <li>${doc_helper.t('DOC_GS_GAMEPLAY_B1')}</li>
                <li>${doc_helper.t('DOC_GS_GAMEPLAY_B2')}</li>
                <li>${doc_helper.t('DOC_GS_GAMEPLAY_B3')}</li>
                <li>${doc_helper.t('DOC_GS_GAMEPLAY_B4')}</li>
            </ul>
            <h3>${doc_helper.t('DOC_GS_TIPS_TITLE')}</h3>
            <ul>
                <li>${doc_helper.t('DOC_GS_TIPS_1')}</li>
                <li>${doc_helper.t('DOC_GS_TIPS_2')}</li>
                <li>${doc_helper.t('DOC_GS_TIPS_3')}</li>
                <li>${doc_helper.t('DOC_GS_TIPS_4')}</li>
                <li>${doc_helper.t('DOC_GS_TIPS_5')}</li>
            </ul>
        </div>
    </div>
    <hr />
    <div class="row" id="download-firs">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_DOWNLOAD_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p style="margin-top:1em;">${doc_helper.t('DOC_GS_DOWNLOAD_INTRO')}</p>
            <ul>
                <li><strong>${doc_helper.t('DOC_GS_DOWNLOAD_B1_PREFIX')}</strong><a href="http://wiki.openttd.org/Content_downloading">${doc_helper.t('DOC_GS_DOWNLOAD_B1_LINK')}</a>${doc_helper.t('DOC_GS_DOWNLOAD_B1_SUFFIX')}</li>
                <li>${doc_helper.t('DOC_GS_DOWNLOAD_B2_PREFIX')}<a href="${doc_helper.link('code_reference')}">${doc_helper.t('DOC_GS_DOWNLOAD_B2_LINK')}</a>${doc_helper.t('DOC_GS_DOWNLOAD_B2_SUFFIX')}</li>
            </ul>
        </div>
    </div>
    <hr />
    <div class="row" id="vehicles">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_VEHICLES_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p style="margin-top:1em;">${doc_helper.t('DOC_GS_VEHICLES_P1')}</p>
            <p>${doc_helper.t('DOC_GS_VEHICLES_P2')}</p>
            <p>${doc_helper.t('DOC_GS_VEHICLES_P3')}</p>
        </div>
    </div>
    <hr />
    <div class="row" id="choose-economy">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_SETUP_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p style="margin-top:1em;">
                ${doc_helper.t('DOC_GS_SETUP_INTRO_PREFIX')}<a href="${doc_helper.link('economies')}">${doc_helper.t('DOC_GS_SETUP_INTRO_LINK', count=len(firs.economy_manager))}</a>${doc_helper.t('DOC_GS_SETUP_INTRO_SUFFIX')}
            </p>
            <ul>
                <li>${doc_helper.t('DOC_GS_SETUP_B1_PREFIX')}<a href="https://wiki.openttd.org/NewGRF#Activating_NewGRFs">${doc_helper.t('DOC_GS_SETUP_B1_LINK')}</a>${doc_helper.t('DOC_GS_SETUP_B1_SUFFIX')}</li>
                <li>${doc_helper.t('DOC_GS_SETUP_B2')}</li>
                <li>${doc_helper.t('DOC_GS_SETUP_B3')}</li>
                <li>${doc_helper.t('DOC_GS_SETUP_B4')}</li>
            </ul>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_ADVANCED_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p style="margin-top:1em;">${doc_helper.t('DOC_GS_ADVANCED_P1')}</p>
            <p>${doc_helper.t('DOC_GS_ADVANCED_P2')}</p>
        </div>
    </div>
    <hr />
    <div class="row" id="conflicts">
        <div class="col-xs-12 col-sm-4">
            <h2>${doc_helper.t('DOC_GS_CONFLICTS_TITLE')}</h2>
        </div>
        <div class="col-xs-12 col-sm-8">
            <p style="margin-top:1em;">${doc_helper.t('DOC_GS_CONFLICTS_P1')}</p>
            <p>${doc_helper.t('DOC_GS_CONFLICTS_P2')}</p>
            <p>${doc_helper.t('DOC_GS_CONFLICTS_P3_PREFIX')}<a href="${doc_helper.link('code_reference')}#incompatible-grfs">${doc_helper.t('DOC_GS_CONFLICTS_P3_LINK')}</a>${doc_helper.t('DOC_GS_CONFLICTS_P3_SUFFIX')}</p>
        </div>
    </div>
    <hr />
    <br />
    <br />
    <br />
    <br />
</div>
</tal:main_template>

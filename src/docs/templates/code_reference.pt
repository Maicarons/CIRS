<tal:page_with_sidebar_template metal:use-macro="load: main_template.pt">
<div metal:fill-slot='body'>
    <div class="page-header text-center">
        <h2>${doc_helper.t('DOC_CR_TITLE')}</h2>
        <ul class="list-inline">
            <li class="nav-header">${doc_helper.t('DOC_CR_TITLE')}</li>
            <li><a href="#source">${doc_helper.t('DOC_CR_NAV_SOURCE')}</a></li>
            <li><a href="#compiling">${doc_helper.t('DOC_CR_NAV_COMPILING')}</a></li>
            <li><a href="#cargos">${doc_helper.t('DOC_CR_NAV_CARGOS', count=len(firs.cargo_manager))}</a></li>
            <li><a href="#industries">${doc_helper.t('DOC_CR_NAV_INDUSTRIES', count=len(firs.industry_manager))}</a></li>
            <li><a href="#incompatible-grfs">${doc_helper.t('DOC_CR_NAV_INCOMPATIBLE', count=len(incompatible_grfs))}</a></li>
        </ul>
    </div>
    <div id="source">
        <h3>${doc_helper.t('DOC_CR_SOURCE_TITLE')}</h3>
        <p>${doc_helper.t('DOC_CR_SOURCE_P1_PREFIX')}<a href="${metadata['repo_url']}">${doc_helper.t('DOC_CR_SOURCE_P1_LINK')}</a>${doc_helper.t('DOC_CR_SOURCE_P1_SUFFIX')}</p>
        <p>${doc_helper.t('DOC_CR_SOURCE_P2_PREFIX')}<a href="http://www.gnu.org/licenses/gpl-2.0.html">${doc_helper.t('DOC_CR_SOURCE_P2_LINK')}</a>${doc_helper.t('DOC_CR_SOURCE_P2_SUFFIX')}</p>
    </div>
    <br />
    <hr />

    <section id="compiling">
        <h3>${doc_helper.t('DOC_CR_COMPILING_TITLE')}</h3>
        <p>${doc_helper.t('DOC_CR_COMPILING_P1')}</p>
        <p>${doc_helper.t('DOC_CR_DEPENDENCIES')}</p>
        <ul>
            <li><a href="https://www.python.org/">${doc_helper.t('DOC_CR_DEP_PYTHON')}</a></li>
            <li><a href="https://newgrf-specs.tt-wiki.net/wiki/NML:Getting_started">${doc_helper.t('DOC_CR_DEP_NML')}</a></li>
            <li><a href="http://chameleon.readthedocs.org/en/latest/">${doc_helper.t('DOC_CR_DEP_CHAMELEON')}</a></li>
            <li><a href="https://pypi.python.org/pypi/Markdown">${doc_helper.t('DOC_CR_DEP_MARKDOWN')}</a></li>
            <li><a href="http://www.graphviz.org">${doc_helper.t('DOC_CR_DEP_GRAPHVIZ')}</a></li>
        </ul>
    </section>
    <br />
    <hr />

    <div id="cargos">
        <h3>${doc_helper.t('DOC_CR_CARGOS_TITLE', count=len(firs.cargo_manager))} <small>${doc_helper.t('DOC_CR_SMALL_LABEL')}</small></h3>
        <p>
            ${doc_helper.t('DOC_CR_FRAX_P1')}
            <a href="https://grf.farm/polar_fox/frax_latest.html">&#187; ${doc_helper.t('DOC_CR_FRAX_LINK')}</a>
        </p>
        <p>${doc_helper.t('DOC_CR_FRAX_P2')}</p>
        <p><small>${doc_helper.t('DOC_CR_PRICE_NOTE')}</small></p>
        <p><small>${doc_helper.t('DOC_CR_TOWN_GROWTH_NOTE')}</small></p>
        <table class="table table-striped tablesorter firs-table">
            <thead>
                <tr>
                    <th>${doc_helper.t('DOC_CR_TH_NAME')}</th>
                    <th>${doc_helper.t('DOC_CR_TH_LABEL')}</th>
                    <th>${doc_helper.t('DOC_CR_TH_ICON')}</th>
                    <th class="number">${doc_helper.t('DOC_CR_TH_WEIGHT')}</th>
                    <th nowrap="true" class="number">${doc_helper.t('DOC_CR_TH_PRICE_FACTOR')}</th>
                    <th class="text">${doc_helper.t('DOC_CR_TH_CARGO_CLASSES')}</th>
                    <th class="text">${doc_helper.t('DOC_CR_TH_TOWN_GROWTH')}</th><!--! request by Zuu, don't just delete this because it's boring -->
                    <th nowrap="true">${doc_helper.t('DOC_CR_TH_SPRITES_DONE')}</th>
                </tr>
            </thead>
            <tbody>
                <tal:cargos repeat="item doc_helper.get_registered_cargo_sorted_by_name()">
                    <tal:cargo define="name item[0]; cargo item[1]">
                        <tr>
                            <td>
                                <a href="${doc_helper.link('cargos')}#${cargo.id}">${doc_helper.get_cargo_name(cargo)}</a>
                            </td>
                            <td>${cargo.cargo_label}</td>
                            <td>
                                <span style="display:inline-block;
                                             width:20px;
                                             height:20px;
                                             background-image:url('static/img/cargoicons.png');
                                             background-position:-${20 + 40 * cargo.icon_indices[0]}px -${20 + 40 * cargo.icon_indices[1]}px;">
                                </span>
                            </td>
                            <td class="number">${cargo.weight}</td>
                            <td class="number">${cargo.price_factor}</td>
                            <td class="text">${doc_helper.pretty_print_cargo_classes(cargo)}</td>
                            <td class="text">${cargo.town_growth_effect}</td>
                            <td>${cargo.sprites_complete}</td>
                        </tr>
                    </tal:cargo>
                </tal:cargos>
            </tbody>
        </table>
    </div>
    <br />
    <hr />
    <br />

    <div id="industries">
        <h3>${doc_helper.t('DOC_CR_INDUSTRIES_TITLE', count=len(firs.industry_manager))} <small>${doc_helper.t('DOC_CR_SMALL_LABEL')}</small></h3>
        <p class="pull-right"><a href="http://newgrf-specs.tt-wiki.net/wiki/IndustryDefaultProps">&#187; ${doc_helper.t('DOC_CR_INDUSTRY_ID_LINK')}</a></p>
        <table class="table table-striped tablesorter firs-table">
            <thead>
                <tr>
                    <th>${doc_helper.t('DOC_CR_TH_NAME')}</th>
                    <th nowrap="true" class="number">${doc_helper.t('DOC_CR_TH_ID')} <span class="muted">${doc_helper.t('DOC_CR_TH_DECIMAL')}</span></th>
                    <th nowrap="true" class="number">${doc_helper.t('DOC_CR_TH_AVAILABLE_FROM')}</th>
                    <th nowrap="true" class="number">${doc_helper.t('DOC_CR_TH_MAP_COLOUR')}</th>
                    <th nowrap="true">${doc_helper.t('DOC_CR_TH_STATION_NAME')}</th>
                    <th nowrap="true">${doc_helper.t('DOC_CR_TH_SPRITES_DONE')}</th>
                    <th nowrap="true">${doc_helper.t('DOC_CR_TH_ANIMATED_TILES')}</th>
                </tr>
            </thead>
            <tbody>
                <tal:industries repeat="item doc_helper.get_industries_sorted_by_name()">
                    <tal:industry define="name item[0]; industry item[1]">
                        <tr>
                            <td>
                                <a href="${doc_helper.link('industries')}#${industry.id}">${' / '.join(doc_helper.get_industry_all_names(industry))}</a>
                            </td>
                            <td class="number">${global_constants.industry_numeric_ids[industry.id]}</td>
                            <td class="number">
                                ${industry.get_property('map_colour', None)}
                                <span style="background-color:rgb${doc_helper.get_industry_colour(industry)};
                                             border:solid 1px #000;
                                             width:16px;
                                             height:16px;
                                             display:inline-block;
                                             vertical-align:top;
                                             margin-top:1px;
                                             margin-left:2px;">
                                </span>
                            </td>
                            <td>${doc_helper.get_nearby_station_name(industry)}</td>
                            <td>${industry.sprites_complete}</td>
                            <td>${industry.animated_tiles_fixed}</td>
                        </tr>
                    </tal:industry>
                </tal:industries>
            </tbody>
        </table>
    </div>
    <br />
    <hr />
    <br />

    <div id="incompatible-grfs">
        <h3>${doc_helper.t('DOC_CR_INCOMPATIBLE_TITLE', count=len(incompatible_grfs))} <small>${doc_helper.t('DOC_CR_SMALL_LABEL')}</small></h3>
        <table class="table table-striped tablesorter firs-table">
            <thead>
                <tr>
                    <th>${doc_helper.t('DOC_CR_TH_NAME')}</th>
                    <th>${doc_helper.t('DOC_CR_TH_GRFID')}</th>
                </tr>
            </thead>
            <tbody>
                <tal:incompatible repeat="incompatible_grf incompatible_grfs">
                    <tr>
                        <td>
                            ${incompatible_grf.grfname}
                        </td>
                        <td>
                            ${incompatible_grf.grfid}
                        </td>
                    </tr>
                </tal:incompatible>
            </tbody>
        </table>
    </div>
</div>
</tal:page_with_sidebar_template>
